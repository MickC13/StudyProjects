<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
         version="4.0">

    <display-name>Лабораторная работа № 8 — GWT</display-name>

    <!-- Серверная часть удалённого GWT-RPC сервиса. -->
    <servlet>
        <servlet-name>parcelService</servlet-name>
        <servlet-class>ru.leti.lab8.server.ParcelServiceImpl</servlet-class>
    </servlet>

    <!-- Путь совпадает с именем скомпилированного модуля и @RemoteServiceRelativePath. -->
    <servlet-mapping>
        <servlet-name>parcelService</servlet-name>
        <url-pattern>/lab8/parcelService</url-pattern>
    </servlet-mapping>

    <welcome-file-list>
        <welcome-file>ParcelModule.html</welcome-file>
    </welcome-file-list>
</web-app>
