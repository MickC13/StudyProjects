<?xml version="1.0" encoding="UTF-8"?>

<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>NIC</groupId>
  <artifactId>mvnweb</artifactId>
  <version>0.0.1-SNAPSHOT</version>
  <!-- Тип итогового артефакта: WAR-архив для размещения в Tomcat. -->
  <packaging>war</packaging>

  <name>mvnweb Maven Webapp</name>
  <!-- Адрес сайта проекта; в шаблоне оставлено демонстрационное значение. -->
  <url>http://www.example.com</url>

  <!-- Общие настройки проекта: кодировка исходных файлов и версия Java. -->
  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <maven.compiler.source>8</maven.compiler.source>
    <maven.compiler.target>8</maven.compiler.target>
  </properties>

  <dependencies>
    <!-- JUnit - библиотека для модульного тестирования программы.
         Область действия test означает, что зависимость доступна только
         при компиляции и запуске тестов и не включается в WAR-архив. -->
    <dependency>
      <groupId>junit</groupId>
      <artifactId>junit</artifactId>
      <version>4.13.1</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <!-- Имя создаваемого WAR-файла: target/mvnweb.war. -->
    <finalName>mvnweb</finalName>
    <!-- Здесь зафиксированы версии плагинов Maven.
         Раздел pluginManagement сам не запускает плагины. При типе war
         Maven связывает их задачи со стандартными фазами сборки. -->
    <pluginManagement>
      <plugins>
        <!-- clean:clean удаляет каталог target и результаты предыдущей
             сборки. Запускается командой mvn clean. -->
        <plugin>
          <artifactId>maven-clean-plugin</artifactId>
          <version>3.4.0</version>
        </plugin>
        <!-- resources:resources копирует ресурсы приложения в target/classes,
             а resources:testResources - ресурсы тестов в target/test-classes.
             Выполняется в фазах process-resources и process-test-resources. -->
        <plugin>
          <artifactId>maven-resources-plugin</artifactId>
          <version>3.3.1</version>
        </plugin>
        <!-- compiler:compile компилирует исходный код приложения,
             compiler:testCompile - исходный код тестов.
             Выполняется в фазах compile и test-compile. -->
        <plugin>
          <artifactId>maven-compiler-plugin</artifactId>
          <version>3.13.0</version>
        </plugin>
        <!-- surefire:test запускает модульные тесты в фазе test
             и сохраняет результаты в target/surefire-reports. -->
        <plugin>
          <artifactId>maven-surefire-plugin</artifactId>
          <version>3.3.0</version>
        </plugin>
        <!-- war:war формирует WAR-архив из web-ресурсов, классов
             и зависимостей приложения в фазе package. -->
        <plugin>
          <artifactId>maven-war-plugin</artifactId>
          <version>3.4.0</version>
        </plugin>
        <!-- install:install помещает собранный WAR и POM в локальный
             Maven-репозиторий в фазе install. -->
        <plugin>
          <artifactId>maven-install-plugin</artifactId>
          <version>3.1.2</version>
        </plugin>
        <!-- deploy:deploy публикует WAR и POM в удаленный Maven-репозиторий
             в фазе deploy. Для работы требуется настроить этот репозиторий. -->
        <plugin>
          <artifactId>maven-deploy-plugin</artifactId>
          <version>3.1.2</version>
        </plugin>
      </plugins>
    </pluginManagement>
  </build>
</project>
